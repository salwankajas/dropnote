# Server-side administrator login. Set these in the host's secret environment settings.
# Do not use these example values in production.
DROPNOTE_ADMIN_EMAIL=admin@example.com
DROPNOTE_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Local HTTP development uses false; set true for HTTPS deployments if proxy detection is unavailable.
DROPNOTE_COOKIE_SECURE=false

# Optional PostgreSQL connection string (e.g. Neon Serverless Postgres).
# When provided, Dropnote uses PostgreSQL with connection pooling instead of SQLite.
# DATABASE_URL=postgresql://username:password@ep-example.neon.tech/neondb?sslmode=require

# Optional SQLite path (used only when DATABASE_URL is unset).
# DROPNOTE_DB=dropnote.sqlite3
